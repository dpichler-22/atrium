{
  "manifest_version": 3,
  "name": "Atrium",
  "version": "1.3.0",
  "description": "A quiet new tab: clock, world times, search with commands, and your links.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/app-16.png",
    "32": "icons/app-32.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["tabs", "history", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://open.er-api.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://accounts.google.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "accounts",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
